      "sizes": "192x192"
    },
    {
      "src": "/assets/logo-512.png",
      "type": "image/png",
      "sizes": "512x512"
    }
  ],
  "screenshots": [
    {
      "src": "/assets/screenshot_home.png",
      "sizes": "1280x720",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "The Metallic homepage"
    },
    {
      "src": "/assets/screenshot_google.png",
      "sizes": "1280x720",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Browsing Google"
    }
  ]
